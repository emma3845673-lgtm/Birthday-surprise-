* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: linear-gradient(135deg,#fff0f6,#fff9fc,#ffe6f0);
  color: #70445a;
  font-family: Georgia,serif;
}

.website {
  max-width: 780px;
  margin: auto;
  padding: 15px;
}

header {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 35px 10px;
}

.tag {
  color: #d94d8a;
  font: bold 11px Arial,sans-serif;
  letter-spacing: 3px;
}

h1 {
  color: #d94d8a;
  font-size: clamp(42px,10vw,72px);
  font-weight: normal;
  line-height: 1.1;
}

h2 {
  color: #c94e87;
  font-weight: normal;
  text-align: center;
}

p {
  line-height: 1.8;
}

.heart {
  font-size: 45px;
  margin: 15px;
  animation: beat 1.2s infinite;
}

@keyframes beat {
  50% { transform: scale(1.2); }
}

button {
  background: #ed80ad;
  color: white;
  border: none;
  border-radius: 30px;
  padding: 14px 23px;
  margin: 10px;
  cursor: pointer;
  font-size: 14px;
}

button:hover {
  background: #d94d8a;
}

.card {
  background: #ffffffed;
  border: 1px solid #ffd8e8;
  border-radius: 23px;
  padding: 25px 18px;
  margin: 22px 0;
  box-shadow: 0 10px 30px #d65b8a15;
}

.center {
  text-align: center;
}

.countdown {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  margin: 25px 0;
}

.countdown div {
  background: #ffe5f0;
  padding: 14px;
  border-radius: 15px;
  min-width: 65px;
}

.countdown b {
  display: block;
  color: #d94d8a;
  font: bold 27px Arial;
}

.countdown small {
  font: 11px Arial;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 12px;
}

.photo {
  background: white;
  border: 1px solid #f4d2e1;
  padding: 9px;
  text-align: center;
  box-shadow: 0 5px 15px #00000010;
}

.photo img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  background: #ffe6f0;
}

.photo label {
  display: block;
  color: #d94d8a;
  font: 12px Arial;
  padding: 10px 0;
}

.photo input {
  width: 100%;
  font-size: 11px;
}

.photo p {
  font-style: italic;
  font-size: 13px;
}

.reasons {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 10px;
}

.reasons div {
  background: #fff0f6;
  padding: 16px;
  border-radius: 15px;
  line-height: 1.7;
}

.letter {
  display: none;
  text-align: left;
  background: #fff5fa;
  border: 1px solid #ffd8e8;
  border-radius: 16px;
  padding: 22px;
  margin-top: 18px;
  line-height: 1.9;
}

.biglove {
  color: #d94d8a;
  font-size: clamp(40px,10vw,65px);
  margin: 25px 0;
}

.final {
  background: linear-gradient(145deg,#ffe4f0,#fff8fb);
  text-align: center;
}

footer {
  text-align: center;
  padding: 35px 10px;
  color: #bd7d99;
  font-size: 13px;
}

@media(max-width:450px) {
  .gallery,.reasons {
    grid-template-columns: 1fr;
  }
  .photo img {
    height: 260px;
  }
}

// His birthday: November 8, 2026
// Uses the local time of the device.

const birthday = new Date(2026, 10, 8, 0, 0, 0);

function updateCountdown() {
  let diff = birthday.getTime() - Date.now();

  if (diff <= 0) {
    document.getElementById("birthdayMessage").textContent =
      "Happy Birthday, My Love! 🎂💗";
    diff = 0;
  }

  document.getElementById("days").textContent =
    Math.floor(diff / 86400000);

  document.getElementById("hours").textContent =
    Math.floor((diff % 86400000) / 3600000);

  document.getElementById("minutes").textContent =
    Math.floor((diff % 3600000) / 60000);

  document.getElementById("seconds").textContent =
    Math.floor((diff % 60000) / 1000);
}

updateCountdown();
setInterval(updateCountdown, 1000);

// Open and close letters
function toggleLetter(id) {
  const letter = document.getElementById(id);

  letter.style.display =
    letter.style.display === "block" ? "none" : "block";
}

// Add your own photos
function showPhoto(event, id) {
  const file = event.target.files[0];

  if (!file) return;

  if (!file.type.startsWith("image/")) return;

  const reader = new FileReader();

  reader.onload = function() {
    document.getElementById(id).src = reader.result;
  };

  reader.readAsDataURL(file);
}

